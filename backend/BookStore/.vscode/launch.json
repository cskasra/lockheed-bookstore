{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug BookStore.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/BookStore.Api/bin/Debug/net10.0/BookStore.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/BookStore.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:7477;https://localhost:7478"
      },
    }
  ]
}
